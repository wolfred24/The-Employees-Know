<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SmartStorage</AssemblyName>
    <RootNamespace>SmartStorage</RootNamespace>
    <Version>0.2.0</Version>
    <NoWarn>$(NoWarn);MSB3277;MSB3245;CS0436</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/1C7025DA7025BC00/SteamLibrary/steamapps/common/Schedule I</GameDir>
    <GameManagedPath>$(GameDir)/MelonLoader/Il2CppAssemblies</GameManagedPath>
    <MelonLoaderPath>$(GameDir)/MelonLoader/net6</MelonLoaderPath>
